      },
      "models": {
        "qwen3.6:35b": {
          "name": "Qwen 3.6 35b"
	},
        "qwen3.6:27b": {
          "name": "Qwen 3.6 27b"
	},
        "deepseek-r1": {
          "name": "DeepSeek R1"
	},
        "qwen3.5-coder:30b": {
	  "name": "Qwen 3.5 Coder - 30b"
	}
      }
    }
  }
}
